    "commander": "^14.0.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.3.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
